@page "/cart"
@using System.Security.Claims
@using JO.Models
@using JO.Services
@inject ICartService CartService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<Navigation />

<Card>
    <h2 class="mt-4 mb-3 text-center">Votre panier</h2>

    @if (CartItems == null)
    {
        <div class="text-center">
            <p>Chargement du panier...</p>
        </div>
    }
    else if (!CartItems.Any())
    {
        <div class="alert alert-info text-center">Votre panier est vide.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered responsive-table">
                <thead class="table-light">
                    <tr>
                        <th>Ticket</th>
                        <th>Quantité</th>
                        <th>Prix unitaire</th>
                        <th>Total</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in CartItems)
                    {
                        <tr>
                            <td >
                                <div class="d-flex align-items-center">
                                    <img src="@item.Offer.ImageUrl" alt="@item.Offer.Name" style="width: 50px; height: 50px; object-fit: cover; margin-right: 10px;" />
                                    <span>@item.Offer.Name</span>
                                </div>
                            </td>
                            <td data-label="Quantité">
                                <div class="input-group input-group-sm ms-auto" style="max-width: 130px;">
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => DecreaseQuantity(item)">-</button>
                                    <input type="number"
                                           class="form-control text-center"
                                           @bind="item.Qty"
                                           @bind:event="oninput"
                                           @onchange="(e) => UpdateQuantity(item.Offer.Id, item.Qty)"
                                           min="0" />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => IncreaseQuantity(item)">+</button>
                                </div>
                            </td>
                            <td data-label="Prix unitaire">@item.Offer.Price€</td>
                            <td data-label="Total">@(item.Qty* item.Offer.Price)€</td>
                            <td data-label="Action">
                                <button class="btn btn-icon text-danger p-0 ms-auto" @onclick="() => RemoveFromCart(item.Offer.Id)">
                                    <span class="oi oi-trash" style="font-size: 1.5rem;"></span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mt-4 pt-3 border-top border-secondary-subtle">
            <h5 class="cart-total-text mb-3 mb-sm-0">
                Total général : <span class="gold-amount">@TotalAmount€</span>
            </h5>
            <div class="d-flex flex-column flex-sm-row gap-2 w-100 w-sm-auto">
                <a href="/offres" class="btn btn-gold-outline text-center">Continuer ma commande</a>
                <button class="btn btn-gold" @onclick="ProceedToCheckout">Passer la commande</button>
            </div>
        </div>
    }
</Card>

@code {
    public List<CartItem> CartItems { get; private set; }
    public decimal TotalAmount { get; private set; } = 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            var cart = await CartService.GetCart(userId);

            if (cart?.CartItems != null)
            {
                CartItems = cart.CartItems;
                TotalAmount = CartItems.Sum(ci =>
                    (ci.Offer != null ? ci.Offer.Price : 0) * ci.Qty);
            }
            else
            {
                CartItems = new List<CartItem>();
            }
        }
    }

    private async Task IncreaseQuantity(CartItem item)
    {
        item.Qty++;
        await UpdateQuantity(item.Offer.Id, item.Qty);
    }

    private async Task DecreaseQuantity(CartItem item)
    {
        if (item.Qty > 1)
        {
            item.Qty--;
            await UpdateQuantity(item.Offer.Id, item.Qty);
        }
        else
        {
            await RemoveFromCart(item.Offer.Id);
        }
    }

    private async Task UpdateQuantity(int offerId, int newQty)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId)) return;

        if (newQty <= 0)
        {
            await RemoveFromCart(offerId);
            return;
        }

        var response = await CartService.UpdateOfferQuantity(userId, offerId, newQty);
        if (response != null && response.Success)
        {
            var cart = await CartService.GetCart(userId);
            CartItems = cart?.CartItems ?? new List<CartItem>();
            TotalAmount = CartItems.Sum(ci => (ci.Offer != null ? ci.Offer.Price : 0) * ci.Qty);
            StateHasChanged();
        }
    }

    private async Task RemoveFromCart(int offerId)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            var response = await CartService.RemoveOfferFromCart(userId, offerId);
            if (response.Success)
            {
                Console.WriteLine($"Offer with ID {offerId} updated in cart!");
                var cart = await CartService.GetCart(userId);
                CartItems = cart?.CartItems ?? new List<CartItem>();
                TotalAmount = CartItems.Sum(ci => (ci.Offer != null ? ci.Offer.Price : 0) * ci.Qty);
                StateHasChanged();
            }
            else
            {
                Console.WriteLine($"Failed to update offer in cart: {response.Message}");
            }
        }
    }

    private void ProceedToCheckout()
    {
        NavigationManager.NavigateTo("/personaldata");
    }
}