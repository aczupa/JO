@page "/offers-table"
@using JO.Models
@using JO.Services

<Navigation />

@if (Offers == null)
{
    <div class="loading text-center my-5">
        <p class="text-gold">Chargement des offres...</p>
    </div>
}
else if (Offers.Any())
{
    <Card>
        <div class="table-responsive">
            <table class="table table-borderless responsive-table mb-0">
                <thead>
                    <tr class="text-uppercase text-gold border-bottom border-secondary">
                        <th></th>
                        <th>Offre</th>
                        <th>Prix</th>
                        <th>Billets</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var offer in Offers)
                    {
                        <tr class="offer-row hover-shadow align-middle">
                            <td class="centered-cell" data-label="Image">
                                <img class="round-image" src="@offer.ImageUrl" alt="@offer.Name" />
                            </td>

                            <td data-label="Offre">
                                <div class="pt-2">
                                    <div class="offer-name centered-subdiv fw-bold">@offer.Name</div>
                                    <div class="offer-position centered-subdiv text-muted small">@offer.Description</div>
                                </div>
                            </td>

                            <td class="centered-cell offer-chiffres fw-semibold gold-amount" data-label="Prix">
                                @offer.Price€
                            </td>

                            <td class="centered-cell offer-chiffres" data-label="Billets">
                                @offer.TicketCount
                            </td>

                            <td class="centered-cell text-end" data-label="Action">
                                <button class="btn btn-gold-edit ms-auto"
                                        @onclick="@(() => NavigateToOfferDetail(offer.Id))"
                                        title="Modifier">
                                    <span class="oi oi-pencil me-1"></span> Modifier
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Card>
}
else
{
    <div class="no-offers text-center my-5">
        <p class="text-muted">Aucune offre trouvée.</p>
    </div>
}

@code {
    [Inject] private IOfferService OfferService { get; set; }
    [Inject] private NavigationManager NavigationManager { get; set; }

    private List<Offer>? Offers;

    protected override async Task OnInitializedAsync()
    {
        var response = await OfferService.GetOffers();
        Offers = response.Offers;
    }

    private void NavigateToOfferDetail(int offerId)
    {
        NavigationManager.NavigateTo($"/offer/{offerId}");
    }
}
