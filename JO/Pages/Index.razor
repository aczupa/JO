@page "/"

@inject NavigationManager Navigation

<Navigation />

<!-- HERO -->

<section class="container py-5 text-center">

    <span class="badge text-uppercase px-3 py-2 rounded-pill fw-bold mb-3 hero-badge">
        Événement Ultra Premium
    </span>

    <h1 class="display-3 fw-bold mb-3 hero-title">
        <span>Summer University Games 2027</span><br />
        Excellence &nbsp; Élégance &nbsp; Prestige
    </h1>

    <p class="lead mx-auto mb-4 hero-text">
        Une édition exceptionnelle où le sport rencontre le luxe absolu.
        Une expérience qui élève chaque discipline au rang d’art.
    </p>

    <button class="btn btn-lg rounded-pill px-4 shadow-sm hero-button"
            @onclick='() => Navigation.NavigateTo("/offres")'>
        Réservez vos tickets
    </button>

</section>

<!-- ABOUT -->

<section class="container py-5">

    <div class="row align-items-center g-5">

        <div class="col-lg-6 animate-fadeInUp">

            <div class="overflow-hidden rounded-4 shadow-lg border-0 about-image">

                <img src="/Images/Swimming.jpg"
                     alt="Summer Games"
                     class="img-fluid w-100 object-fit-cover" />

            </div>

        </div>

        <div class="col-lg-6 animate-fadeInUp">

            <div class="ps-lg-4">

                <h2 class="fw-bold fs-1 mb-3 about-title">
                    Un événement d’exception
                </h2>

                <p class="fs-5 mb-3 about-text">
                    Les Summer University Games 2027 adoptent une esthétique Black & Gold :
                    noir profond, accents dorés, lignes épurées et ambiance ultra premium.
                </p>

                <p class="mb-4 about-text">
                    Une atmosphère immersive, des disciplines iconiques,
                    une mise en scène luxueuse et moderne.
                </p>

            </div>

        </div>

    </div>

</section>

<!-- SPORTS -->

<section class="container py-5">

    <div class="row g-4">

        @foreach (var item in new[]
                {
                ("/Images/Athletics.jpg","Athlétisme","Vitesse. Impact. Élégance sportive."),
                ("/Images/Baseball.jpg","Baseball","Un classique revisité en version haute performance."),
                ("/Images/Basketball.jpg","Basketball","Puissance verticale et intensité visuelle."),
                ("/Images/box.jpg","Boxe","Force brute, précision absolue."),
                ("/Images/Cycling.jpg","Cyclisme","Endurance et design aérodynamique."),
                ("/Images/Football.jpg","Football","Le sport roi, en édition prestige."),
                ("/Images/Gymnastics.jpg","Gymnastique","Fluidité, maîtrise, excellence."),
                ("/Images/HighJump.jpg","Saut en hauteur","L’art de dépasser les limites."),
                ("/Images/Hockey.jpg","Hockey","Vitesse glacée, intensité premium.")
                })
        {
            <div class="col-md-6 col-lg-4 animate-fadeInUp">

                <div class="card h-100 border-0 shadow-sm hover-shadow rounded-4 overflow-hidden sport-card">

                    <img src="@item.Item1"
                         alt="@item.Item2"
                         class="card-img-top fixed-img sport-image" />

                    <div class="card-body text-center p-4">

                        <h5 class="card-title fw-bold sport-title">
                            @item.Item2
                        </h5>

                        <p class="card-text small sport-description">
                            @item.Item3
                        </p>

                    </div>

                </div>

            </div>
        }

    </div>

</section>

<!-- WHY CHOOSE -->

<section class="container py-5">

    <div class="rounded-4 p-5 bg-dark">

        <h3 class="fw-bold mb-4 text-center text-md-start features-title">
            <i class="bi bi-stars me-2"></i>
            Pourquoi participer aux Summer University Games 2027 ?
        </h3>

        <div class="row g-3 features">

            <div class="col-md-6">

                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-mortarboard-fill fs-5 me-3 feature-icon"></i>
                    <span><strong>Une célébration du sport universitaire</strong> réunissant étudiants et universités du monde entier.</span>
                </div>

                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-globe-europe-africa fs-5 me-3 feature-icon"></i>
                    <span><strong>Une dimension internationale</strong> favorisant les échanges culturels, le respect et l'amitié.</span>
                </div>

                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-trophy-fill fs-5 me-3 feature-icon"></i>
                    <span><strong>Des compétitions de haut niveau</strong> mettant en lumière les talents de la nouvelle génération.</span>
                </div>

            </div>

            <div class="col-md-6">

                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-people-fill fs-5 me-3 feature-icon"></i>
                    <span><strong>Une expérience ouverte à tous</strong> pour les étudiants, les familles, les supporters et le grand public.</span>
                </div>

                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-lightbulb-fill fs-5 me-3 feature-icon"></i>
                    <span><strong>L'innovation et l'excellence</strong> au service du sport, de l'éducation et du développement durable.</span>
                </div>

            </div>

        </div>

    </div>

</section>