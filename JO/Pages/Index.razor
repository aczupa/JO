@page "/"

@inject NavigationManager Navigation

<Navigation/>

<!-- HERO SECTION -->
<div class="container py-5 text-center animate-fadeInUp">
    <span class="badge bg-primary-subtle text-primary text-uppercase px-3 py-2 rounded-pill fw-bold mb-3">
        Événement Exclusif
    </span>
    <h1 class="display-3 fw-bold tracking-tight mb-3">
        <span class="text-primary">Summer Games 2026</span><br />
        L’Été des Performances d’Exception
    </h1>
    <p class="lead text-secondary mx-auto mb-4" style="max-width: 700px;">
        Une célébration prestigieuse du sport, de l’élégance et de l’excellence.
        Découvrez des disciplines iconiques, des compétitions de haut niveau et des moments inoubliables.
    </p>
    <button class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm"
            @onclick='() => Navigation.NavigateTo("/offres")'>
        Explorer les offres exclusives
    </button>

    
</div>

<!-- ABOUT SECTION -->
<div class="container my-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-6 animate-fadeInUp">
            <div class="overflow-hidden rounded-4 shadow-lg">
                <img src="/Images/Swimming.jpg" alt="Summer Games" class="img-fluid w-100 object-fit-cover" style="max-height: 400px;">
            </div>
        </div>

        <div class="col-lg-6 animate-fadeInUp">
            <div class="ps-lg-4">
                <h2 class="fw-bold fs-1 mb-3">Un événement d’exception</h2>
                <p class="text-secondary fs-5 mb-3">
                    Les Summer Games 2026 vous invitent à vivre une expérience unique, où la passion du sport rencontre le raffinement d’un événement premium.
                </p>
                <p class="text-secondary mb-4">
                    Chaque discipline est soigneusement mise en scène pour offrir un spectacle captivant, dans une ambiance élégante et vibrante.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- CARDS GRID SECTION -->
<div class="container my-5">
    <div class="row g-4">

        <div class="col-md-6 col-lg-4 animate-fadeInUp">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all rounded-4 overflow-hidden">
                <img src="/Images/Athletics.jpg" class="card-img-top fixed-img " alt="Athlétisme" style="height: 220px;">
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold">Athlétisme</h5>
                    <p class="card-text text-secondary small">La vitesse, la puissance et la précision réunies dans une discipline mythique.</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 animate-fadeInUp">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all rounded-4 overflow-hidden">
                <img src="/Images/Baseball.jpg" class="card-img-top fixed-img" alt="Baseball" style="height: 220px;">
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold">Baseball</h5>
                    <p class="card-text text-secondary small">Un classique américain revisité dans une ambiance estivale prestigieuse.</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 animate-fadeInUp">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all rounded-4 overflow-hidden">
                <img src="/Images/Basketball.jpg" class="card-img-top fixed-img" alt="Basketball" style="height: 220px;">
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold">Basketball</h5>
                    <p class="card-text text-secondary small">Des matchs intenses où la technique rencontre le spectacle.</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 animate-fadeInUp">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all rounded-4 overflow-hidden">
                <img src="/Images/box.jpg" class="card-img-top fixed-img" alt="Boxe" style="height: 220px;">
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold">Boxe</h5>
                    <p class="card-text text-secondary small">Force, stratégie et maîtrise dans un ring électrisant.</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 animate-fadeInUp">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all rounded-4 overflow-hidden">
                <img src="/Images/Cycling.jpg" class="card-img-top fixed-img" alt="Cyclisme" style="height: 220px;">
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold">Cyclisme</h5>
                    <p class="card-text text-secondary small">Des parcours exigeants pour les amateurs de vitesse et d’endurance.</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 animate-fadeInUp">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all rounded-4 overflow-hidden">
                <img src="/Images/Football.jpg" class="card-img-top fixed-img" alt="Football" style="height: 220px;">
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold">Football</h5>
                    <p class="card-text text-secondary small">Le sport roi dans une ambiance estivale vibrante.</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 animate-fadeInUp">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all rounded-4 overflow-hidden">
                <img src="/Images/Gymnastics.jpg" class="card-img-top fixed-img" alt="Gymnastique" style="height: 220px;">
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold">Gymnastique</h5>
                    <p class="card-text text-secondary small">Grâce et performance réunies dans des chorégraphies spectaculaires.</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 animate-fadeInUp">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all rounded-4 overflow-hidden">
                <img src="/Images/HighJump.jpg" class="card-img-top fixed-img" alt="Saut en hauteur" style="height: 220px;">
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold">Saut en hauteur</h5>
                    <p class="card-text text-secondary small">Un défi aérien où chaque centimètre compte.</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 animate-fadeInUp">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all rounded-4 overflow-hidden">
                <img src="/Images/Hockey.jpg" class="card-img-top fixed-img" alt="Hockey" style="height: 220px;">
                <div class="card-body text-center p-4">
                    <h5 class="card-title fw-bold">Hockey</h5>
                    <p class="card-text text-secondary small">Rapidité, précision et esprit d’équipe sur la glace.</p>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- FEATURES SECTION -->
<div class="container my-5 animate-fadeInUp">
    <div class="p-4 p-md-5 bg-light rounded-4 border-0 shadow-sm">
        <h3 class="fw-bold mb-4 text-center text-md-start">
            <i class="bi bi-stars text-primary me-2"></i>Pourquoi choisir les Summer Games ?
        </h3>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-star-fill text-primary fs-5 me-3"></i>
                    <span><strong>Événements exclusifs</strong> réservés aux participants</span>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-music-note-beamed text-primary fs-5 me-3"></i>
                    <span><strong>Ambiance raffinée</strong> avec animations et musique live</span>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-trophy-fill text-primary fs-5 me-3"></i>
                    <span><strong>Compétitions de haut niveau</strong> dans des espaces modernes</span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-people-fill text-primary fs-5 me-3"></i>
                    <span><strong>Activités pour tous</strong> dans un cadre sécurisé</span>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-cup-hot-fill text-primary fs-5 me-3"></i>
                    <span><strong>Espaces lounge</strong> pour se détendre et profiter</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="offers"></div>